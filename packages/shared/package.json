{
  "name": "@naitikos/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Universal utilities. Framework-free, domain-free, portable.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo coverage"
  },
  "devDependencies": {
    "@naitikos/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
