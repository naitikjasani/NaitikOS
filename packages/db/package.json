{
  "name": "@naitikos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Persistence. Drizzle schema, migrations, repositories. Semi-durable — the schema outlives the ORM.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed/index.ts",
    "clean": "rm -rf .turbo coverage"
  },
  "dependencies": {
    "@naitikos/core": "workspace:*",
    "@naitikos/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@naitikos/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
