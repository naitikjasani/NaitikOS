# Strict, explicit dependency resolution.
#
# Blueprint §5.0 makes the layering rule the central durability guarantee, and
# the FIRST line of enforcement is dependency declaration itself: a package that
# does not declare React in its package.json cannot import React, regardless of
# what any lint rule says. Hoisting would silently undermine that by making
# every transitive dependency importable from everywhere.
#
# ESLint boundary rules (blueprint §11.3) are the second line. Both are needed.
node-linker=isolated
hoist=false
shamefully-hoist=false

# Fail loudly rather than resolving to something unexpected.
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest

# Reproducibility — blueprint §11.8 requires every tag to be reproducible.
prefer-frozen-lockfile=true
save-exact=true

# Security — blueprint §5.14.
audit-level=moderate
