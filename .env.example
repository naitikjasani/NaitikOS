# Copy to .env and fill in. `.env` is gitignored — blueprint §5.14.
#
# Nothing in this file may ever contain a real secret. It documents the shape of
# the environment, not its contents.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Port 5433, not 5432 — see the comment there.
# Production points at Supabase's pooled connection string instead.
DATABASE_URL=postgresql://naitikos:naitikos@localhost:5433/naitikos

# ---------------------------------------------------------------------------
# Supabase and auth
# ---------------------------------------------------------------------------
# `apps/web/lib/env.ts` validates all of these at startup and its failure
# message says to copy this file — so until 7 September 2026 it named a file
# that documented one of the six variables it needs.

# The project URL the browser talks to. Public by design: it appears in the
# CSP `connect-src`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The anon key. Public, and safe **only because of migration 0004** — RLS is
# enabled and unpolicied on every table and the PostgREST grants are revoked,
# so a holder of this key reaches a database that returns nothing. Remove that
# migration and this line becomes a full data breach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The origin this deployment serves. Explicit rather than read from the request
# `Host` header, which an attacker controls — a CSRF check against an
# attacker-supplied expected origin is not a check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The allowlist (§5.4). Comma-separated; normally one address.
AUTH_ALLOWLIST=you@example.com

# Service-role key. Optional and deliberately unused today; declared so that
# its absence is a conscious state rather than an undiscovered one. It bypasses
# RLS entirely. Leave it unset unless something genuinely needs it.
# SUPABASE_SERVICE_ROLE_KEY=
